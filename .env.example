NODE_ENV=development
PORT=3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_MINUTE_LIMIT=10
THROTTLE_HOUR_TTL=3600000
THROTTLE_HOUR_LIMIT=100
# Required — the app will refuse to start without a valid REDIS_URL.
# Used by: session store (1-hour TTL per conversation), throttler storage, and cache.
#
# Local dev:
#   docker run --rm -p 6379:6379 redis:7-alpine
#   REDIS_URL=redis://localhost:6379
#
# Render production:
#   Add the "Key Value" add-on in your Render dashboard.
#   Render injects the internal URL automatically — copy the "Internal URL"
#   value (format: redis://red-<id>:<port>) into your service's environment.
#   Use the *internal* URL (not the external one) so traffic stays on
#   Render's private network and avoids egress charges.
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000
FRONTEND_URL=https://www.omarderkaoui.cc/
