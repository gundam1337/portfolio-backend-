NODE_ENV=development
PORT=3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_MINUTE_LIMIT=10
THROTTLE_HOUR_TTL=3600000
THROTTLE_HOUR_LIMIT=100
# Required — the app will refuse to start without a valid REDIS_URL.
# Used by: session store (1-hour TTL per conversation), throttler storage, and cache.
#
# Local dev:
#   docker run --rm -p 6379:6379 redis:7-alpine
#   REDIS_URL=redis://localhost:6379
#
# Render production:
#   Add the "Key Value" add-on in your Render dashboard.
#   Render injects the internal URL automatically — copy the "Internal URL"
#   value (format: redis://red-<id>:<port>) into your service's environment.
#   Use the *internal* URL (not the external one) so traffic stays on
#   Render's private network and avoids egress charges.
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000
FRONTEND_URL=https://www.omarderkaoui.cc/

# OpenAI — required for query rewriting (Step 4) and future embedding/generation steps.
# The app will refuse to start if this is absent.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional — which chat model to use for query rewriting.  Defaults to gpt-4o-mini.
OPENAI_REWRITER_MODEL=gpt-4o-mini
# Optional — embedding model and output dimensions for Step 5.
# Changing OPENAI_EMBEDDING_MODEL or OPENAI_EMBEDDING_DIMENSIONS invalidates
# all cached embeddings because the cache key includes both values.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Qdrant vector database — required for RAG indexing (Step I1+) and runtime search.
# The app will refuse to start if QDRANT_URL or QDRANT_API_KEY are absent.
#
# Cloud setup (recommended):
#   1. Create a free cluster at https://cloud.qdrant.io/
#   2. Copy the cluster URL (format: https://<id>.<region>.aws.cloud.qdrant.io)
#   3. Generate an API key from the cluster's Access tab
#
# Local dev (no auth required, omit QDRANT_API_KEY or leave it blank):
#   docker run --rm -p 6333:6333 qdrant/qdrant
#   QDRANT_URL=http://localhost:6333
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-api-key-here
# Optional — name of the Qdrant collection storing document chunks. Default: personal_docs
QDRANT_COLLECTION=personal_docs

# Retrieval tuning — optional, applied at runtime during vector search (Step 7).
# RETRIEVAL_TOP_K: how many chunks to fetch from Qdrant per query. Default: 15.
#   Higher values give the reranker more candidates but increase Qdrant latency.
RETRIEVAL_TOP_K=15
# RETRIEVAL_SCORE_FLOOR: minimum cosine similarity score for "high confidence" retrieval.
#   If the top result's score is below this threshold the response is flagged as
#   low_confidence so downstream steps can short-circuit. Range: 0–1. Default: 0.3.
RETRIEVAL_SCORE_FLOOR=0.3
